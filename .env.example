# ============================================
# FRIENDS STORE - Production Configuration
# ============================================
# Copy this file to .env and update values

# Server Port (default: 3000)
PORT=3000

# JWT Secret Key (MUST change for production!)
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=friends_production_secret_key_change_in_env_file_2024

# Firebase Configuration (optional if using social auth)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# Node Environment
NODE_ENV=production

# Admin WhatsApp contact (optional)
ADMIN_WHATSAPP=201094708407

# CORS Configuration (add your domain)
# CORS_ORIGIN=https://yourdomain.com
